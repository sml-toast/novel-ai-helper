# Novel AI · AI 能力配置样例
#
# 使用方法：复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会入库）
#   cp .env.example .env
#
# 安全约定（需求 F073）：
#   1. 真实密钥只允许出现在本文件（.env）与运行环境中
#   2. 严禁写入任何 .md 文档、源码、测试用例或提交信息
#   3. 若密钥曾外泄，请立即到服务商处轮换失效，不要只做删除

# 大模型服务地址（OpenAI 兼容协议，末尾不要带 /chat/completions）
# 例：https://api.openai.com/v1  或本地 Ollama http://127.0.0.1:11434/v1
# 优先级：环境变量 NOVEL_AI_BASE_URL > 项目库 projects.ai_base_url（设置页保存）
NOVEL_AI_BASE_URL=

# 模型名称
# 例：gpt-4o-mini / deepseek-chat / qwen-plus / qwen2.5:7b
# 优先级：环境变量 NOVEL_AI_MODEL > 项目库 projects.ai_model（设置页保存）
NOVEL_AI_MODEL=

# API Key（Bearer Token）
# 优先级（F075）：项目库加密保存的密钥 > 环境变量 NOVEL_AI_API_KEY > 无（mock）
# 即：设置页保存过密钥后，本变量不再生效；清空设置页密钥才回落到这里。
# 未配置任何密钥时，AI 功能自动降级为本地 mock，界面会标注「本地演示模式」，其余功能不受影响
# 项目库中的密钥经 aes-256-gcm 加密存储，主密钥位于 ~/.novel-ai/master.key
NOVEL_AI_API_KEY=

# ---- 以下为可选的服务与数据配置 ----

# API 服务端口（默认 8787）
# NOVEL_API_PORT=8787

# API 监听地址（默认 127.0.0.1，仅本机可达）
# 改为 0.0.0.0 会暴露到局域网：任何能访问该端口的设备都可读写全部稿件，请自行评估风险
# NOVEL_API_HOST=127.0.0.1

# 允许的跨域来源，逗号分隔（默认 http://127.0.0.1:5175 与 http://localhost:5175）
# NOVEL_ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175

# 静态页面服务端口（默认 5175）
# NOVEL_WEB_PORT=5175

# SQLite 数据库路径（默认 .data/novel-ai.sqlite）
# 测试与开发隔离时可用它指向独立库文件
# NOVEL_DB_PATH=.data/novel-ai.sqlite

# 主密钥文件路径（默认 ~/.novel-ai/master.key）
# 仅用于测试隔离，**不要在生产中指向项目内目录**：.data/ 与 .env 都已被 .gitignore，
# 主密钥若随仓库一起被清理，已保存的 AI 密钥将永久无法解密
# NOVEL_MASTER_KEY_PATH=
